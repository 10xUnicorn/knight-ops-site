{
  "manifest_version": 3,
  "name": "Knight Ops Recorder",
  "short_name": "KO Recorder",
  "version": "1.0.0",
  "description": "Record your screen, a window, a tab, or your camera. Auto-transcribed and instantly shareable from your Knight Ops dashboard.",
  "minimum_chrome_version": "116",

  "permissions": [
    "tabCapture",
    "desktopCapture",
    "offscreen",
    "storage",
    "scripting",
    "tabs",
    "activeTab",
    "downloads",
    "notifications",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],

  "background": { "service_worker": "background.js", "type": "module" },

  "action": {
    "default_title": "Knight Ops Recorder",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "options_page": "options.html",

  "commands": {
    "toggle-recording": {
      "suggested_key": { "default": "Alt+Shift+R", "mac": "Alt+Shift+R" },
      "description": "Start or stop recording"
    },
    "take-screenshot": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Alt+Shift+S" },
      "description": "Capture a screenshot of this tab"
    }
  },

  "web_accessible_resources": [
    {
      "resources": ["overlay.css", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
